---
import { Icon } from '@astrojs/starlight/components';

interface Props {
    title: string;
    school: string;
    period: string;
    cgpa?: string;
    icon?: string;
    tags?: string[];
    achievements?: string[];
}

const {
    title,
    school,
    period,
    cgpa,
    icon = 'open-book',
    tags = [],
    achievements = [],
} = Astro.props;
---

<div class="education-entry">
    <div class="header-row">
        <div class="icon-container">
            <Icon name={icon} />
        </div>
        <div class="title-group">
            <h3>{title}</h3>
            <div class="school-meta">
                <span class="school">{school}</span>
                {
                    cgpa && (
                        <>
                            <span class="separator">|</span>
                            <span class="cgpa">
                                <strong>CGPA: {cgpa}</strong>
                            </span>
                        </>
                    )
                }
                <span class="separator">|</span>
                <span class="period">
                    {period}
                </span>
            </div>
        </div>
    </div>

    <div class="highlights-row">
        <slot />
        {
            achievements.length > 0 && (
                <div class="education-tags achievements">
                    {achievements.map((achievement) => (
                        <span class="tag achievement-tag">🏆 {achievement}</span>
                    ))}
                </div>
            )
        }
        {
            tags.length > 0 && (
                <div class="education-tags">
                    {tags.map((tag) => (
                        <span class="tag">{tag}</span>
                    ))}
                </div>
            )
        }
    </div>

    <style>
        .education-entry {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding: 1.75rem 2rem;
            background: var(--sl-color-gray-6);
            border: 1px solid var(--sl-color-gray-5);
            border-radius: 1rem;
            transition:
                transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 0.4s ease;
            position: relative;
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .education-entry:hover {
            transform: translateX(10px);
            box-shadow: 10px 10px 30px rgba(0, 0, 0, 0.15);
            border-color: var(--sl-color-accent);
        }

        .education-entry::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--sl-color-accent);
            transform: scaleY(0);
            transform-origin: top;
            transition: transform 0.4s ease;
        }

        .education-entry:hover::after {
            transform: scaleY(1);
        }

        .header-row {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .icon-container {
            width: 3.5rem;
            height: 3.5rem;
            background: var(--sl-color-accent-low);
            color: var(--sl-color-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.75rem;
            font-size: 1.75rem;
            box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.05);
            flex-shrink: 0;
        }

        .title-group h3 {
            margin: 0 !important;
            font-size: 1.3rem !important;
            font-weight: 700 !important;
            color: var(--sl-color-white) !important;
            line-height: 1.2 !important;
        }

        .school-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.75rem;
            font-size: 0.95rem;
            font-weight: 500;
            margin-top: 0.2rem;
            color: var(--sl-color-gray-3);
        }

        .school {
            color: var(--sl-color-accent);
            font-weight: 600;
        }

        .period {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-family: var(--sl-font-mono);
            color: var(--sl-color-gray-3);
            font-size: 0.85rem;
        }

        .separator {
            color: var(--sl-color-gray-4);
            font-weight: 400;
        }

        .cgpa {
            color: var(--sl-color-gray-2);
            font-size: 0.9rem;
        }

        .highlights-row {
            margin-top: 0.5rem;
        }

        /* Target Starlight Asides inside the slots */
        .highlights-row :global(.starlight-aside) {
            margin: 0 !important;
            width: 100%;
            text-align: justify;
        }

        .education-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            margin-top: 1rem;
        }

        .education-tags.achievements {
            margin-top: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .tag {
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.3rem 0.85rem;
            background: var(--sl-color-accent-low);
            color: var(--sl-color-accent-high);
            border-radius: 2rem;
            border: 1px solid var(--sl-color-accent);
            font-family: var(--sl-font-mono);
            transition: all 0.2s ease;
            line-height: 1.4;
        }

        .achievement-tag {
            background: rgba(218, 165, 32, 0.15);
            border-color: rgba(218, 165, 32, 0.5);
            color: var(--sl-color-white);
        }

        .education-entry:hover .tag {
            background: var(--sl-color-accent);
            color: white;
        }

        .education-entry:hover .tag.achievement-tag {
            background: #ffd700;
            border-color: #ffd700;
            color: #000 !important;
        }

        @media (max-width: 768px) {
            .education-entry {
                padding: 1.75rem;
            }
            .header-row {
                flex-direction: column;
                text-align: center;
                gap: 1rem;
            }
            .meta-row {
                justify-content: center;
                gap: 1rem;
            }
        }
    </style>
</div>
