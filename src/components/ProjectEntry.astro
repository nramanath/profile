---
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/components/Icons';

interface Props {
    title: string;
    description?: string;
    tags?: string[];
    url?: string;
    icon?: string;
}

const { title, description, tags = [], url, icon = 'puzzle' } = Astro.props;
---

<div class="project-entry">
    <div class="project-icon-container">
        <div class="project-icon">
            <Icon name={icon as StarlightIcon} size="2rem" />
        </div>
    </div>
    <div class="project-details">
        <div class="project-header">
            <div class="header-main">
                <h3>{title}</h3>
                {
                    url && (
                        <a
                            href={url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="project-link"
                        >
                            <Icon name="external" size="1.2rem" />
                        </a>
                    )
                }
            </div>
        </div>
        <div class="project-content">
            {description && <p class="project-description">{description}</p>}
            <div class="project-slot">
                <slot />
            </div>
            {
                tags.length > 0 && (
                    <div class="project-tags">
                        {tags.map((tag) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</div>

<style>
    .project-entry {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1.5rem;
        padding: 1.75rem 2rem;
        background: var(--sl-color-gray-6);
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 1rem;
        transition:
            transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
            box-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
            border-color 0.4s ease;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
        align-items: start;
    }

    .project-entry:hover {
        transform: translateX(10px);
        box-shadow: 10px 10px 30px rgba(0, 0, 0, 0.15);
        border-color: var(--sl-color-accent);
    }

    .project-entry::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: var(--sl-color-accent);
        transform: scaleY(0);
        transform-origin: top;
        transition: transform 0.4s ease;
    }

    .project-entry:hover::after {
        transform: scaleY(1);
    }

    .project-icon-container {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 0.25rem;
    }

    .project-icon {
        color: var(--sl-color-accent);
        background: var(--sl-color-accent-low);
        width: 4rem;
        height: 4rem;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .project-details {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .project-header h3 {
        margin: 0 !important;
        font-size: 1.4rem !important;
        font-weight: 800 !important;
        color: var(--sl-color-white) !important;
        line-height: 1.2 !important;
        letter-spacing: -0.02em !important;
    }

    .header-main {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        width: 100%;
    }

    .project-link {
        color: var(--sl-color-gray-3);
        transition: color 0.2s ease;
    }

    .project-link:hover {
        color: var(--sl-color-accent);
    }

    .project-description {
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--sl-color-gray-2);
        margin: 0 0 1rem 0;
    }

    .project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-top: 1rem;
    }

    .tag {
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.3rem 0.85rem;
        background: var(--sl-color-accent-low);
        color: var(--sl-color-accent-high);
        border-radius: 2rem;
        border: 1px solid var(--sl-color-accent);
        font-family: var(--sl-font-mono);
        transition: all 0.2s ease;
    }

    .project-entry:hover .tag {
        background: var(--sl-color-accent);
        color: white;
    }

    .project-slot :global(ul) {
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .project-slot :global(li) {
        position: relative;
        padding-left: 1.5rem;
        line-height: 1.5;
        color: var(--sl-color-gray-3);
    }

    .project-slot :global(li::before) {
        content: '→';
        position: absolute;
        left: 0;
        color: var(--sl-color-accent);
        font-weight: bold;
    }

    @media (max-width: 768px) {
        .project-entry {
            grid-template-columns: 1fr;
            gap: 1.5rem;
            padding: 1.75rem;
        }
        .project-icon-container {
            justify-content: center;
        }
        .project-header {
            text-align: center;
        }
        .header-main {
            justify-content: center;
        }
        .project-tags {
            justify-content: center;
        }
        .project-slot :global(li) {
            text-align: center;
            padding-left: 0;
        }
        .project-slot :global(li::before) {
            display: none;
        }
    }
</style>
