---
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/components/Icons';

interface Props {
    title: string;
    company: string;
    companyUrl?: string;
    location: string;
    period: string;
    icon?: string;
}

const { title, company, companyUrl, location, period, icon = 'pencil' } = Astro.props;
---

<div class="experience-entry">
    <div class="experience-icon-container">
        <div class="experience-icon">
            <Icon name={icon as StarlightIcon} size="2rem" />
        </div>
    </div>
    <div class="experience-details">
        <div class="experience-header">
            <div class="header-main">
                <h3>{title}</h3>
            </div>
            <div class="experience-meta">
                <span class="company">
                    {
                        companyUrl ? (
                            <a href={companyUrl} target="_blank" rel="noopener noreferrer">
                                {company}
                            </a>
                        ) : (
                            company
                        )
                    }
                </span>
                <span class="separator">|</span>
                <span class="location">{location}</span>
                <span class="separator">|</span>
                <span class="period">{period}</span>
            </div>
        </div>
        <div class="experience-content">
            <slot />
        </div>
    </div>
</div>

<style>
    .experience-entry {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 2rem;
        padding: 2.25rem;
        background: var(--sl-color-gray-6);
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 1rem;
        transition:
            transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
            box-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
            border-color 0.4s ease;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
        align-items: start;
    }

    .experience-entry:hover {
        transform: translateX(10px);
        box-shadow: 10px 10px 30px rgba(0, 0, 0, 0.15);
        border-color: var(--sl-color-accent);
    }

    .experience-entry::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: var(--sl-color-accent);
        transform: scaleY(0);
        transform-origin: top;
        transition: transform 0.4s ease;
    }

    .experience-entry:hover::after {
        transform: scaleY(1);
    }

    .experience-icon-container {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 0.25rem;
    }

    .experience-icon {
        color: var(--sl-color-accent);
        background: var(--sl-color-accent-low);
        width: 4rem;
        height: 4rem;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .experience-details {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .experience-header {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .experience-header h3 {
        margin: 0 !important;
        font-size: 1.6rem !important;
        font-weight: 800 !important;
        color: var(--sl-color-white) !important;
        line-height: 1.2 !important;
        letter-spacing: -0.02em !important;
    }

    .header-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem;
        width: 100%;
    }

    .experience-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.1rem;
        font-weight: 600;
        margin-top: 0.2rem;
    }

    .separator {
        color: var(--sl-color-gray-4);
        font-weight: 400;
    }

    .location {
        color: var(--sl-color-gray-3);
        font-weight: 500;
    }

    .company {
        color: var(--sl-color-accent);
    }

    .company a {
        color: inherit;
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .company a:hover {
        opacity: 0.8;
        text-decoration: underline;
    }

    .separator {
        color: var(--sl-color-gray-4);
    }

    .location {
        color: var(--sl-color-gray-2);
    }

    .period {
        font-size: 0.95rem;
        color: var(--sl-color-gray-3);
        font-family: var(--sl-font-mono);
        font-weight: 500;
    }

    .experience-content {
        font-size: 1rem;
        color: var(--sl-color-gray-3);
    }

    .experience-content :global(ul) {
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .experience-content :global(li) {
        position: relative;
        padding-left: 1.5rem;
        line-height: 1.5;
        text-align: justify;
    }

    .experience-content :global(li::before) {
        content: '→';
        position: absolute;
        left: 0;
        color: var(--sl-color-accent);
        font-weight: bold;
    }

    .experience-content :global(strong) {
        color: var(--sl-color-gray-1);
        font-weight: 700;
        font-size: 1.05rem;
    }

    @media (max-width: 768px) {
        .experience-entry {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 1.5rem;
            padding: 1.75rem;
        }
        .experience-icon-container {
            justify-content: center;
        }
        .experience-header {
            align-items: center;
        }
        .experience-meta {
            justify-content: center;
        }
        .experience-content :global(li) {
            text-align: center;
            padding-left: 0;
        }
        .experience-content :global(li::before) {
            display: none;
        }
    }
</style>
