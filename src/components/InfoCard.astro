---
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/components/Icons';

interface Props {
    title: string;
    subtitle?: string;
    icon?: string;
    link?: string;
}

const { title, subtitle, icon = 'badge', link } = Astro.props;
---

<div class="info-card">
    <div class="info-icon-container">
        <div class="info-icon">
            <Icon name={icon as StarlightIcon} size="1.5rem" />
        </div>
    </div>
    <div class="info-details">
        <div class="info-header">
            <h4>{title}</h4>
            {
                link && (
                    <a href={link} target="_blank" rel="noopener noreferrer" class="info-link">
                        <Icon name="external" size="1rem" />
                    </a>
                )
            }
        </div>
        {subtitle && <p class="info-subtitle">{subtitle}</p>}
        <div class="info-content">
            <slot />
        </div>
    </div>
</div>

<style>
    .info-card {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1.25rem;
        padding: 1.25rem;
        background: var(--sl-color-gray-6);
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.75rem;
        transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
        position: relative;
        overflow: hidden;
        margin-bottom: 1rem;
        align-items: center;
    }

    .info-card:hover {
        transform: translateX(8px);
        border-color: var(--sl-color-accent);
        background: var(--sl-color-gray-5);
    }

    .info-card::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 3px;
        height: 100%;
        background: var(--sl-color-accent);
        transform: scaleY(0);
        transform-origin: top;
        transition: transform 0.4s ease;
    }

    .info-card:hover::after {
        transform: scaleY(1);
    }

    .info-icon {
        color: var(--sl-color-accent);
        background: var(--sl-color-accent-low);
        width: 3rem;
        height: 3rem;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .info-details {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .info-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .info-header h4 {
        margin: 0 !important;
        font-size: 1.15rem !important;
        font-weight: 700 !important;
        color: var(--sl-color-white) !important;
    }

    .info-link {
        color: var(--sl-color-gray-3);
        transition: color 0.2s ease;
    }

    .info-link:hover {
        color: var(--sl-color-accent);
    }

    .info-subtitle {
        font-size: 0.85rem;
        color: var(--sl-color-gray-3);
        margin: 0;
        font-weight: 500;
    }

    .info-content {
        font-size: 0.85rem;
        color: var(--sl-color-gray-4);
    }

    @media (max-width: 640px) {
        .info-card {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 1.25rem;
        }
        .info-icon-container {
            justify-content: center;
            display: flex;
        }
        .info-header {
            justify-content: center;
            gap: 1rem;
        }
    }
</style>
